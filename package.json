{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "license": "MIT",
  "scripts": {
    "preinstall": "rm -f package-lock.json yarn.lock",
    "build": "pnpm --filter @workspace/mobile run build",
    "dev:ios": "pnpm --filter @workspace/mobile run dev:ios",
    "dev:backend": "pnpm --filter @workspace/backend run dev",
    "start:backend": "pnpm --filter @workspace/backend run start",
    "typecheck": "pnpm --filter @workspace/mobile run typecheck",
    "test": "pnpm --filter @workspace/backend test && pnpm --filter @workspace/mobile test",
    "test:coverage": "pnpm --filter @workspace/backend test:coverage && pnpm --filter @workspace/mobile test:coverage",
    "load:health": "k6 run load-tests/health.js",
    "load:rest": "k6 run load-tests/rest-flow.js",
    "load:websocket": "k6 run load-tests/websocket.js",
    "load:broadcast": "k6 run load-tests/broadcast.js"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
